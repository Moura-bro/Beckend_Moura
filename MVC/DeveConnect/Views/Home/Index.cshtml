@{
    ViewData[index: "Title"] = "Logo DeveConnect";
}
<link rel="stylesheet" href="~/css/login.css">
<main>
        <div>


            <form class="estilo-formulario">
                <img src="~/imagens/logo roxa md.svg" alt="logo Devconnect">

                <div class="formularios-campos">
                   <label  for="">Nome de usuario</label>
                   <input type="text" name="" id="">
                </div>

                <div class="formularios-campos">
                   <label  for="">Senha</label>
                   <input type="password" name="" id="">
                </div>

                <button type="submit" class="formulario-botao-azul">Entrar</button>
                
                <p>ou</p>

                <a href="#">Esqueceu a Senha?</a>
            </form>

            <section id="secao-cadastro" class="estilo-formulario">
                <p>Não tem uma conta? <a href="../pages/cadastro.html">Cadastre-se</a></p>
            </section>

            <p>Obtenha o aplicativo</p>

            <section id="secao-instalacao">
                <img src="~/imagens/app-store.svg" alt="Imagem da istalacao no app-store">

                <img src="~/imagens/google-play.svg" alt="Imagem da istalacao no Play-store">
            </section>
        </div>
    </main>