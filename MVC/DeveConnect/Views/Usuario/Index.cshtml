@model DeveConnect.Models.TbUsuario
@{
    ViewData[index: "Title"] = "Logo DeveConnect";
}
<link rel="stylesheet" href="~/css/cadastro.css">

<script defer >
        let usuarioNovoCadastrado = "@ViewBag.UsuarioNovoCadastrado";

    if (usuarioNovoCadastrado == "Nao cadastrado") {
        alert("Nao foi possivel cadastrar o usuario, fale com nossos administradores.");
    }
</script>
<h1>Tela de Cadastro - DevConnect</h1>

<main>
    <div>
        <form class="estilo-formulario" asp-action="Index" asp-controller="Usuario" enctype="multipart/form-data">
            <img src="~/imagens/logo roxa md.svg" alt="logo Devconnect">

            <p class="Textos">Cadastrar-se para comunidade exclusiva de desevolvedores</p>

            <div class="formularios-cadastro">
                <label class="inv" for="">Nome e Sobrenome</label>
                <input type="text" asp-for="NomeCompleto" id="caixa" placeholder="Nome e Sobrenome">
            </div>

            <div class=" formularios-cadastro">
                <label class="inv" for="">Nome de usuario</label>
                <input type="text" asp-for="NomeUsuario" id="caixa" placeholder="Nome de usuario">
            </div>

            <div class="formularios-cadastro">
                <label class="inv" for="">E-mail</label>
                <input type="email" asp-for="Email" id="caixa" placeholder="E-mail">
            </div>

            <div class="formularios-cadastro">
                <label class="inv" for="">Senha</label>
                <input type="password" asp-for="Senha" id="caixa" placeholder="Senha">
            </div>

            @* <div class="formulario-campos">
                <label id="upload" for="campo-upload">Faca o upload da sua imagem aqui...</label>
                <input class="Caixa-de-Texto" type="file" name="imagem" id="campo-upload">
            </div> *@

                <div  class="formulario-campos"> 
                <label id="upload" for="campo-upload">Faça seu uploud aqui...</label>
                <input class = "Caixa-de-Texto" type="file" name="Imagem" id="campo-upload">
            </div>

            <button type="submit" class="formulario-botao-azul">Cadastrar-se</button>

            <p class="Textos">Ao se Cadastrar voce comcorda com nossos termos,Politica de dados e Politica de Cookies
            </p>


        </form>


        <section id="secao-login" class="estilo-formulario">
            <p>Tem uma conta?<a href="../pages/index.html">Conecte-se</a></p>
        </section>




    </div>
</main>